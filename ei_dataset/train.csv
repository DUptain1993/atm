import csv

def get_average_salary(filename):
  total = 0
  count = 0

  with open(filename, 'r') as csvfile:
    csvreader = csv.reader(csvfile)
    next(csvreader) # skip header

    # loop through the CSV rows
    for row in csvreader:
      total += int(row[1])
