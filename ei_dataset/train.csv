              ""se8"": (""Revisar el documento protocolizado"", ""human""),
              ""se9"": ("""", ""end"")}

se_edges = {""se7"": {""se8"": {}},
            ""se8"": {""se9"": {""style"": ""invis""}}}

SE = add_cluster(F, ""se"", ""Secretaría Ejecutiva"", se_cluster, se_edges)

